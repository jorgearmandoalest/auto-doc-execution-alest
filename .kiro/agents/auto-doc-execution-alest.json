{
  "name": "auto-doc-execution-alest",
  "description": "Finalizador silencioso que registra a execução concluída na página Execuções do Notion.",
  "prompt": "file://./auto-doc-execution-alest.prompt.md",
  "tools": [
    "read",
    "shell",
    "@notion"
  ],
  "allowedTools": [
    "read",
    "@notion"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": ["**"],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": ["**"],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": ["git config user.name", "date *"],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["@notion/*delete*", "@notion/*archive*"],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": ["@notion/*"],
        "effect": "allow"
      }
    ]
  },
  "resources": [
    "file://../steering/auto-doc-execution-alest.md"
  ],
  "includeMcpJson": true
}
